{
  "name": "sight-client",
  "version": "1.4.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:docs": "npx rimraf docs && ng build --configuration docs && copy docs\\index.html docs\\404.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@turf/turf": "^7.4.0",
    "@znemz/cesium-navigation": "^4.0.0",
    "cesium": "^1.144.0",
    "chalk": "^6.0.0",
    "dompurify": "^3.4.13",
    "egm96-universal": "^1.1.1",
    "lodash": "^4.18.1",
    "material-design-icons": "^3.0.1",
    "odf-kit": "^0.13.10",
    "ol": "^10.10.0",
    "prettier": "^3.9.6",
    "proj4": "^2.21.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^22.1.1",
    "@types/lodash": "^4.17.25",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
